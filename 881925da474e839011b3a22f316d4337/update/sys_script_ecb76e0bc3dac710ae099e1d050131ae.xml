        <script><![CDATA[(function executeRule(current, previous) {

  if (!current.state.changesTo('3')) { 
        return;
    }
    // 1. Check Catalog Tasks
    var taskGR = new GlideRecord('sc_task');
    taskGR.addQuery('request_item', current.sys_id);
    taskGR.addQuery('state', '!=', '3');
    taskGR.query();

    if (taskGR.hasNext()) {
        gs.addErrorMessage('All Catalog Tasks must be closed before closing the RITM.');
        current.setAbortAction(true);
        return;
		// throw 'Validation failed';
    }

    // 2. Check Parent Incident
    if (!current.parent.nil()) {

        var incGR = new GlideRecord('incident');

        if (incGR.get(current.parent)) {

            if (incGR.state!='6') { 
                gs.addErrorMessage('Incident must be resolved before closing the RITM.');
                current.setAbortAction(true);
                return;
				// throw 'Validation failed';
            }
        }
    }

})(current, previous);]]></script>
