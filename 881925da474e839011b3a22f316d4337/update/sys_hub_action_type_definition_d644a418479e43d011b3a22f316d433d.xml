        <sys_updated_on>2026-07-21 07:04:42</sys_updated_on>
        <value>(function execute(inputs, outputs) {&#13;
&#13;
    var payload = inputs.payload;&#13;
        gs.info("Inputs: " + JSON.stringify(inputs));&#13;
    // Parse if the payload is a JSON string&#13;
    if (typeof payload === "string") {&#13;
        payload = JSON.parse(payload);&#13;
    }&#13;
&#13;
    var scriptDetails = {};&#13;
&#13;
    // Default values&#13;
    scriptDetails.issue_key = payload.issue.key;&#13;
    scriptDetails.issue_id = payload.issue.id;&#13;
    scriptDetails.sprint_from = "";&#13;
    scriptDetails.sprint_to = "";&#13;
&#13;
    // Find the Sprint change in the changelog&#13;
    if (payload.changelog &amp;&amp; payload.changelog.items) {&#13;
        for (var i = 0; i &lt; payload.changelog.items.length; i++) {&#13;
            var item = payload.changelog.items[i];&#13;
&#13;
            if (item.field === "Sprint") {&#13;
                scriptDetails.sprint_from = item.fromString || "";&#13;
                scriptDetails.sprint_to = item.toString || "";&#13;
                break;&#13;
            }&#13;
        }&#13;
    }&#13;
&#13;
    // Store in Flow Variable (Object)&#13;
    outputs.script_details = scriptDetails;&#13;
&#13;
})(inputs, outputs);</value>
